<?xml version="1.0" encoding="utf-8"?>
<!-- productbuild distribution for Ultimate Trance Gate. @VERSION@ is replaced by build_pkg.sh. -->
<installer-gui-script minSpecVersion="2">
    <title>Ultimate Trance Gate @VERSION@</title>
    <organization>com.mikitalaurenau</organization>
    <domains enable_localSystem="true" enable_currentUserHome="false" enable_anywhere="false"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64" rootVolumeOnly="true"/>
    <os-version min="10.13"/>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <background file="background.png" alignment="bottomleft" scaling="none"/>
    <background-darkAqua file="background.png" alignment="bottomleft" scaling="none"/>

    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
    </choices-outline>

    <choice id="vst3" title="VST3" description="Ultimate Trance Gate.vst3 → /Library/Audio/Plug-Ins/VST3 (Ableton Live, FL Studio, Cubase, Bitwig, Reaper…)">
        <pkg-ref id="com.mikitalaurenau.ultimatetrancegate.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit (AU)" description="Ultimate Trance Gate.component → /Library/Audio/Plug-Ins/Components (Logic Pro, GarageBand, Ableton Live)">
        <pkg-ref id="com.mikitalaurenau.ultimatetrancegate.au"/>
    </choice>

    <pkg-ref id="com.mikitalaurenau.ultimatetrancegate.vst3" version="@VERSION@" onConclusion="none">vst3.pkg</pkg-ref>
    <pkg-ref id="com.mikitalaurenau.ultimatetrancegate.au" version="@VERSION@" onConclusion="none">au.pkg</pkg-ref>
</installer-gui-script>
